{
  "name": "atelier",
  "displayName": "Atelier",
  "description": "git worktree 자동화 VSCode 확장 (비추적 파일 자동 복사 + 워크트리별 setup hook)",
  "version": "0.1.0",
  "publisher": "joungsik",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/joungsik/atelier.git"
  },
  "homepage": "https://github.com/joungsik/atelier#readme",
  "bugs": {
    "url": "https://github.com/joungsik/atelier/issues"
  },
  "engines": {
    "vscode": "^1.117.0",
    "node": ">=20"
  },
  "categories": ["SCM Providers", "Other"],
  "keywords": ["git", "worktree", "claude", "multi-stack"],
  "main": "./out/extension.js",
  "activationEvents": ["onView:atelierWorktrees"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atelier",
          "title": "Atelier",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "atelier": [
        {
          "id": "atelierWorktrees",
          "name": "Worktrees",
          "icon": "$(repo)",
          "contextualTitle": "Atelier Worktrees"
        }
      ]
    },
    "commands": [
      {
        "command": "atelier.refresh",
        "title": "Atelier: 워크트리 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "atelier.create",
        "title": "Atelier: 새 워크트리 생성",
        "icon": "$(add)"
      },
      {
        "command": "atelier.delete",
        "title": "Atelier: 워크트리 삭제",
        "icon": "$(trash)"
      },
      {
        "command": "atelier.openInNewWindow",
        "title": "Atelier: 새 창에서 열기"
      },
      {
        "command": "atelier.openInCurrent",
        "title": "Atelier: 현재 창에서 열기"
      },
      {
        "command": "atelier.syncWorktreeInclude",
        "title": "Atelier: .worktreeinclude 설정 동기화"
      },
      {
        "command": "atelier.showWorktreeInfo",
        "title": "Atelier: 현재 워크트리 정보 표시"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atelier.create",
          "when": "view == atelierWorktrees",
          "group": "navigation@1"
        },
        {
          "command": "atelier.refresh",
          "when": "view == atelierWorktrees",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "atelier.openInNewWindow",
          "when": "view == atelierWorktrees && viewItem =~ /^worktree/",
          "group": "navigation@1"
        },
        {
          "command": "atelier.openInCurrent",
          "when": "view == atelierWorktrees && viewItem =~ /^worktree/",
          "group": "navigation@2"
        },
        {
          "command": "atelier.delete",
          "when": "view == atelierWorktrees && viewItem =~ /^worktree/",
          "group": "9_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "atelier.openInNewWindow",
          "when": "false"
        },
        {
          "command": "atelier.openInCurrent",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Atelier",
      "properties": {
        "atelier.worktreesParentDir": {
          "type": "string",
          "default": "${homeDir}/Workspace/atelier/${repoName}",
          "description": "신규 워크트리 기본 생성 위치의 부모 디렉토리 (placeholder: ${homeDir}, ${workspaceFolder}, ${repoName})"
        },
        "atelier.openMode": {
          "type": "string",
          "enum": ["newWindow", "reuseWindow", "addToWorkspace"],
          "default": "newWindow",
          "description": "워크트리 생성 후 열기 방식"
        },
        "atelier.contextDir.enabled": {
          "type": "boolean",
          "default": true,
          "description": ".context/ 디렉토리 자동 생성"
        },
        "atelier.setup.hook": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "워크트리 생성 후 실행할 셸 명령 배열 (cwd: 워크트리 경로). 예시:\n- Ruby/Rails: `[\"bundle install\", \"bundle exec rails db:prepare\"]`\n- Node: `[\"npm ci\"]` 또는 `[\"npm install\"]`\n- Go: `[\"go mod download\"]`\n- Python: `[\"pip install -r requirements.txt\"]`\n- 다중 스택: `[\"bundle install\", \"npm install\"]`\n- Docker: `[\"docker compose build\"]`",
          "examples": [
            ["bundle install"],
            ["npm ci"],
            ["go mod download"],
            ["bundle install", "npm install"]
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "test": "mocha",
    "lint": "eslint src test",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "mocha": "^11.7.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
